{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://up.ac.th/syllabus/schema/1.0.0",
  "title": "Smart Excel Syllabus Canonical Contract (proposed for Blazor)",
  "description": "Contract v1.0 for independent Excel source and future REG view. SQL DDL is a proposed migration, not a snapshot of existing database.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SchemaVersion",
    "OfferingId",
    "SourceType",
    "ExtractedAt",
    "CourseInfo",
    "Curriculum",
    "Instructors",
    "PLOs",
    "CLOs",
    "ClassMeetings",
    "Exams",
    "StudentGroups",
    "LecturePlans",
    "LabPlans",
    "Assessments",
    "GradeScale",
    "Resources"
  ],
  "properties": {
    "SchemaVersion": {
      "const": "1.0.0"
    },
    "OfferingId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+-[0-9]+-[0-9]{4}-SEC[A-Za-z0-9]+$"
    },
    "SourceType": {
      "type": "string",
      "enum": [
        "ExcelManual",
        "RegView",
        "BlazorManual"
      ]
    },
    "ExtractedAt": {
      "type": "string",
      "format": "date-time"
    },
    "CourseInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "CourseCode": {
          "type": "string"
        },
        "CourseTitleTh": {
          "type": "string"
        },
        "CourseTitleEn": {
          "type": "string"
        },
        "CourseDescriptionTh": {
          "type": "string"
        },
        "CourseDescriptionEn": {
          "type": "string"
        },
        "Credits": {
          "type": "string"
        },
        "LectureHours": {
          "type": "integer"
        },
        "LabHours": {
          "type": "integer"
        },
        "SelfStudyHours": {
          "type": "integer"
        },
        "AcademicYear": {
          "type": "integer"
        },
        "Semester": {
          "type": "string"
        },
        "Section": {
          "type": "string"
        },
        "LastUpdatedDate": {
          "type": "string",
          "format": "date",
          "description": "วันที่ผู้สอนบันทึกหรือปรับปรุงเนื้อหา (YYYY-MM-DD ตาม ค.ศ.); ไม่บังคับกรอก"
        },
        "FacultyName": {
          "type": "string"
        },
        "UniversityName": {
          "type": "string"
        },
        "TeachingLanguage": {
          "type": "string"
        },
        "DeliveryMode": {
          "type": "string"
        },
        "Prerequisites": {
          "type": "string"
        },
        "Remarks": {
          "type": "string"
        }
      },
      "required": [
        "CourseCode",
        "CourseTitleTh",
        "Credits",
        "AcademicYear",
        "Semester",
        "Section"
      ]
    },
    "Curriculum": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "CurriculumCode": {
          "type": "string"
        },
        "CurriculumName": {
          "type": "string"
        },
        "CurriculumRevisionYear": {
          "type": "integer"
        },
        "ProgramCode": {
          "type": "string"
        },
        "ProgramName": {
          "type": "string"
        },
        "DegreeLevel": {
          "type": "string"
        },
        "DepartmentName": {
          "type": "string"
        }
      },
      "required": []
    },
    "Instructors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "StaffId": {
            "type": "string"
          },
          "IsResponsibleInstructor": {
            "type": "boolean"
          },
          "Prefix": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "DisplayName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "Department": {
            "type": "string"
          },
          "LecturePercent": {
            "type": "number"
          },
          "LabPercent": {
            "type": "number"
          },
          "Notes": {
            "type": "string"
          }
        },
        "required": [
          "IsResponsibleInstructor"
        ]
      }
    },
    "PLOs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "PloCode": {
            "type": "string"
          },
          "DescriptionTh": {
            "type": "string"
          },
          "DescriptionEn": {
            "type": "string"
          },
          "Category": {
            "type": "string"
          },
          "Notes": {
            "type": "string"
          }
        },
        "required": [
          "PloCode",
          "DescriptionTh"
        ]
      }
    },
    "CLOs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "CloCode": {
            "type": "string"
          },
          "DescriptionTh": {
            "type": "string"
          },
          "BloomLevel": {
            "type": "string"
          },
          "MappedPloCodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "Notes": {
            "type": "string"
          }
        },
        "required": [
          "CloCode",
          "DescriptionTh"
        ]
      }
    },
    "ClassMeetings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "DayOfWeek": {
            "type": "string"
          },
          "StartTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "EndTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "RoomCode": {
            "type": "string"
          },
          "DeliveryType": {
            "type": "string"
          },
          "Notes": {
            "type": "string"
          }
        },
        "required": []
      }
    },
    "Exams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ExamTypeCode": {
            "type": "string"
          },
          "ExamDate": {
            "type": "string",
            "format": "date"
          },
          "StartTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "EndTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "RoomCode": {
            "type": "string"
          },
          "Notes": {
            "type": "string"
          }
        },
        "required": []
      }
    },
    "StudentGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "StudentProgramName": {
            "type": "string"
          },
          "StudentYearLevel": {
            "type": "integer"
          },
          "RegisteredStudentCount": {
            "type": "integer"
          },
          "StudentCurriculumCode": {
            "type": "string"
          },
          "StudentCurriculumRevisionYear": {
            "type": "integer"
          },
          "Notes": {
            "type": "string"
          }
        },
        "required": []
      }
    },
    "LecturePlans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "WeekNumber": {
            "type": "integer"
          },
          "Topic": {
            "type": "string"
          },
          "LearningActivities": {
            "type": "string"
          },
          "TeachingMethods": {
            "type": "string"
          },
          "MappedCloCodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "AssessmentMethods": {
            "type": "string"
          },
          "Notes": {
            "type": "string"
          }
        },
        "required": [
          "WeekNumber",
          "Topic"
        ]
      }
    },
    "LabPlans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "WeekNumber": {
            "type": "integer"
          },
          "Topic": {
            "type": "string"
          },
          "LearningActivities": {
            "type": "string"
          },
          "TeachingMethods": {
            "type": "string"
          },
          "MappedCloCodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "AssessmentMethods": {
            "type": "string"
          },
          "Notes": {
            "type": "string"
          }
        },
        "required": [
          "WeekNumber",
          "Topic"
        ]
      }
    },
    "Assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "AssessmentCode": {
            "type": "string"
          },
          "AssessmentName": {
            "type": "string"
          },
          "AssessmentType": {
            "type": "string"
          },
          "WeightPercent": {
            "type": "number"
          },
          "MappedCloCodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "Notes": {
            "type": "string"
          }
        },
        "required": [
          "AssessmentName",
          "WeightPercent"
        ]
      }
    },
    "GradeScale": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "Grade": {
            "type": "string"
          },
          "MinimumScore": {
            "type": "number"
          },
          "MaximumScore": {
            "type": "number"
          },
          "Notes": {
            "type": "string"
          }
        },
        "required": []
      }
    },
    "Resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ResourceType": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Author": {
            "type": "string"
          },
          "Year": {
            "type": "integer"
          },
          "Url": {
            "type": "string"
          },
          "Notes": {
            "type": "string"
          }
        },
        "required": []
      }
    }
  }
}
